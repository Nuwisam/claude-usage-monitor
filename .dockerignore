# The build context is the whole repo directory (the `ui` stage needs frontend/), and the
# repo ALSO holds the MariaDB data directory — without this file every `docker compose build`
# would ship hundreds of MB of database to the daemon.
data/
backups/
.git/
node_modules/
frontend/node_modules/
frontend/dist/
__pycache__/
**/__pycache__/
*.pyc
.venv/
venv/
logs/
*.log
*.jsonl

# Secrets have no business entering the image.
.env

# Not needed when building the image.
docs/
scripts/
deploy/
client/
backend/tests/
*.md
