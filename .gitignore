__pycache__/
*.pyc
.venv/
venv/
data/
logs/
*.log
node_modules/
frontend/dist/
.idea/
.vscode/
.DS_Store

# Payload dumps from the statusline — they contain project paths, session names and costs.
# They live in %LOCALAPPDATA%, but should anyone copy them here — they are not committed.
*.jsonl
*.cache.json
.env
# Copies made at deployment (`cp .env .env.bak-<date>`) carry the same secrets, and the
# `.env` pattern above does NOT catch them — that is a literal match. Without this the backup
# sits untracked in the repo directory, waiting for someone to scoop it up.
.env.bak-*
backups/

# Scratchpad: payload dumps, frames from the panel, working notes. Nothing from here goes
# into the repository — and without this rule a single `git add -A` publishes the lot.
tmp/

# Local compose override (networks and ports specific to a single deployment).
docker-compose.override.yml

# Artifacts of `pip install -e` and local tool configuration.
*.egg-info/
.claude/
