__pycache__/
*.pyc
.venv/
venv/
data/
logs/
*.log
node_modules/
frontend/dist/
.idea/
.vscode/
.DS_Store

# Dumpy payloadow ze statusline — zawieraja sciezki projektow, nazwy sesji i koszty.
# Trzymamy je w %LOCALAPPDATA%, ale gdyby ktos skopiowal je tutaj — nie commitujemy.
*.jsonl
*.cache.json
.env
# Kopie robione przy wdrozeniu (`cp .env .env.bak-<data>`) niosa te same sekrety, a wzorzec
# `.env` wyzej ich NIE lapie — to dopasowanie doslowne. Bez tego backup lezy nieusledzony
# w katalogu repo i czeka, az ktos go zgarnie.
.env.bak-*
backups/

# Brudnopis: zrzuty payloadow, klatki z panelu, robocze notatki. Nic stad nie idzie
# do repozytorium — a bez tej reguly jedno `git add -A` publikuje calosc.
tmp/

# Lokalne nadpisanie compose (sieci i porty specyficzne dla jednego wdrozenia).
docker-compose.override.yml

# Artefakty `pip install -e` i lokalna konfiguracja narzedzi.
*.egg-info/
.claude/
