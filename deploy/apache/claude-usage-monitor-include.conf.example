# Claude Usage Monitor — https://usage.example.org/claude-usage
#
# DEPLOYMENT (the secret must NOT reach the repo):
#   EDGE=$(grep -oP 'INGEST_EDGE_KEY=\K.*' /var/lib/claude-usage-monitor/.env)
#   sed "s|__INGEST_EDGE_KEY__|$EDGE|" \
#       /var/lib/claude-usage-monitor/deploy/apache/claude-usage-monitor-include.conf.example \
#       > /etc/apache2/sites-available/claude-usage-monitor-include.conf
#   # append to 0000-example_org-ssl.conf:
#   #   Include sites-available/claude-usage-monitor-include.conf
#   apachectl configtest && systemctl reload apache2
#
# The order of the rules matters — the more specific one first.
# ProxyPass is used with an explicit path (not <Location>), so the prefix is NOT stripped.
# A pattern to follow for further services on the same vhost.

# --- Ingest: machine-to-machine traffic, no SSO ----------------------------
# The edge filter cuts off scanners before they touch Python, the database or the logs.
# This is not serious cryptography — the real authorization is the per-machine Bearer
# checked in the backend (INGEST_TOKENS).
<Location /claude-usage/api/ingest>
    <If "req('X-Ingest-Key') != '__INGEST_EDGE_KEY__'">
        Require all denied
    </If>
</Location>
ProxyPass        /claude-usage/api/ingest http://claude_usage_monitor_backend:8000/api/ingest
ProxyPassReverse /claude-usage/api/ingest http://claude_usage_monitor_backend:8000/api/ingest

# --- Session alerts: same kind of traffic as ingest, same pair of layers ---
# Without this block the path is publicly reachable and is protected by the Bearer token alone —
# meaning scanners hammer their way through to Python. The edge filter is just as mandatory
# here as on ingest, because the endpoint is called by the same client with the same secret.
<Location /claude-usage/api/session-alert>
    <If "req('X-Ingest-Key') != '__INGEST_EDGE_KEY__'">
        Require all denied
    </If>
</Location>
ProxyPass        /claude-usage/api/session-alert http://claude_usage_monitor_backend:8000/api/session-alert
ProxyPassReverse /claude-usage/api/session-alert http://claude_usage_monitor_backend:8000/api/session-alert

# --- SSE stream: a long connection, no buffering ---------------------------
# MUST come BEFORE the /claude-usage/api rule, otherwise the generic one captures the stream.
#
# The missing X-Ingest-Key edge filter is deliberate: the browser calls this endpoint too
# (EventSource adds no header). It is self-protecting — 401 before anything touches the database.
#
# `no-gzip` matters more here than `flushpackets`: the compression filter buffers the stream
# relentlessly and shows up as frames arriving in clumps every 30-60 seconds.
# `timeout=` overrides ProxyTimeout for this worker; a ping every 15 s keeps the connection
# from falling silent anyway, but the limit must be above STREAM_MAX_LIFETIME_SEC.
<Location /claude-usage/api/stream>
    SetEnv proxy-sendchunked 1
    SetEnv no-gzip 1
    SetEnv dont-vary 1
</Location>
ProxyPass        /claude-usage/api/stream http://claude_usage_monitor_backend:8000/api/stream flushpackets=on timeout=1200 retry=0
ProxyPassReverse /claude-usage/api/stream http://claude_usage_monitor_backend:8000/api/stream

# --- Rest of the API: the SSO cookie goes to the backend -------------------
# The backend calls /api/verify itself and enforces ALLOWED_EMAILS. No session =>
# 401 {reason, redirect_url}, NOT 302 — because there is no nginx auth_request here.
# The UI has to answer with a redirect; that is part of the API contract.
ProxyPass        /claude-usage/api http://claude_usage_monitor_backend:8000/api
ProxyPassReverse /claude-usage/api http://claude_usage_monitor_backend:8000/api

RequestHeader set X-Forwarded-Proto "https"
RequestHeader set X-Forwarded-Port "443"

# --- UI ---------------------------------------------------------------------
# The static files are served by THE SAME backend (FastAPI mounts /assets and serves index.html
# as the SPA fallback) — there is no separate nginx container. Two reasons: a host may have its
# Docker address pools exhausted, and the nginx + auth_request variant carries a known pitfall
# in which `$scheme` inside the container is http and `$request_uri` comes without the prefix,
# so after login `rd=` throws the user out to the service root. Here the SSO gate stays in the
# backend, which builds redirect_url from explicit PUBLIC_ORIGIN + APP_BASE_PATH.
#
# THIS RULE MUST BE BELOW the /api rules — ProxyPass is checked in the order written
# and the first match wins. The reverse order would capture the whole API.
RedirectMatch 301 ^/claude-usage$ /claude-usage/
ProxyPass        /claude-usage/ http://claude_usage_monitor_backend:8000/
ProxyPassReverse /claude-usage/ http://claude_usage_monitor_backend:8000/
