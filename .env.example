# --- Baza ---
MARIADB_ROOT_PASSWORD=changeme_root
MARIADB_DATABASE=claude_usage
MARIADB_USER=claude_usage
MARIADB_PASSWORD=changeme_user

# --- Dostep do UI/API (SSO) ---
# Lista adresow uprawnionych do czytania danych przez przegladarke.
# PUSTA = deny all (fail-safe). Nie ma zwiazku z kontami Claude, ktore sledzimy.
ALLOWED_EMAILS=you@example.org
# Nadpisz tylko jesli oauth2-proxy stoi gdzie indziej.
# SSO_VERIFY_URL=http://identity_proxy:8080/api/verify

# --- Ingest: token na KAZDA maszyne ---
# Format: token:nazwa_maszyny[,token2:nazwa2]
# Token identyfikuje MASZYNE. Konto jest rozpoznawane dynamicznie z oauthAccount.accountUuid,
# bo na jednej maszynie przelaczasz sie miedzy kontami przez /login — statyczny label
# przypisywalby polowe probek do zlego konta.
# Wygeneruj: openssl rand -hex 32
INGEST_TOKENS=replace_me_with_random_hex:desktop

# --- Filtr brzegowy w Apache ---
# Wspolny sekret sprawdzany PRZED dotarciem do backendu. Nie jest powazna kryptografia —
# odcina skanery, zeby nie dotykaly Pythona, bazy i logow. Prawdziwa autoryzacja to INGEST_TOKENS.
# Wstawiany do vhosta przy deployu, NIE komitowany. Wygeneruj: openssl rand -hex 32
INGEST_EDGE_KEY=replace_me_with_random_hex

# --- Zachowanie ingestu ---
LOG_LEVEL=INFO
MAX_INGEST_BODY_BYTES=262144
MAX_BACKLOG_ENTRIES=200
CLOCK_SKEW_TOLERANCE_SEC=300
BACKLOG_MAX_AGE_SEC=604800

# Dedup: nowy wiersz tylko gdy wartosc sie zmienila ALBO minelo tyle sekund.
# Sonda odpytuje co ~120 s, a utilization zmienia sie rzadko — bez tego tabela pucholaby
# od identycznych wierszy.
SAMPLE_HEARTBEAT_SEC=300

# Guard monotonicznosci: przy NIEZMIENIONYM resets_at spadek wiekszy niz tyle punktow
# procentowych traktujemy jako nieaktualny odczyt z innej maszyny (kazda ma wlasny cache),
# zapisujemy z flaga stale_read i NIE cofamy stanu biezacego.
MONOTONIC_EPS=0.5

# --- Swiezosc w /api/status ---
# Probka mlodsza niz tyle => "live". Sonda ma throttle 120 s, wiec 300 s daje zapas.
FRESH_WINDOW_SEC=300
# Brak jakiegokolwiek sygnalu od klienta dluzej niz tyle => stan "unknown", nie "0%".
CLIENT_SILENT_SEC=21600

# Porty na hoscie nie sa bindowane. Apache siega backendu po nazwie kontenera
# (pomocnik wpisujacy nazwy kontenerow do /etc/hosts wpisuje ja do /etc/hosts):  http://claude_usage_monitor_backend:8000
