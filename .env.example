# --- Database ---
MARIADB_ROOT_PASSWORD=changeme_root
MARIADB_DATABASE=claude_usage
MARIADB_USER=claude_usage
MARIADB_PASSWORD=changeme_user

# --- UI/API access ---
# REQUIRED. Without this value the container will not start — and that is deliberate: every
# default would be a wrong answer, because only you know whether anything sits in front of
# the backend.
#
#   none    no gate. Only when the service is unreachable from the network — see BACKEND_BIND
#           below. Whoever reaches the port sees all the data.
#   header  a reverse proxy has already authenticated and supplies the address in a header.
#           Allowed ONLY behind a proxy that strips that header from incoming requests.
#   verify  the backend asks an identity service over JSON, forwarding the cookies.
#
# Lowercase, literal match.
AUTH_MODE=none

# List of addresses allowed to read the data. EMPTY = deny all (fail-safe).
# Unrelated to the Claude accounts being tracked. In `none` mode it is not used,
# because there is nowhere to take an address from.
ALLOWED_EMAILS=

# --- AUTH_MODE=header ---
# AUTH_EMAIL_HEADER=X-Forwarded-Email

# --- AUTH_MODE=verify ---
# An endpoint that, from the cookies, answers with JSON saying who the caller is: 200 with
# an address, 401 or 403 for someone not logged in. The field names are configuration, because
# every provider describes them differently; empty = the field is not read.
# AUTH_VERIFY_URL=http://identity-proxy:8080/api/verify
# AUTH_EMAIL_FIELD=email
# AUTH_VERIFIED_AT_FIELD=
# AUTH_REDIRECT_FIELD=
# The login address handed to the browser on a 401, when the service supplies none itself
# (typically: it answers with an HTML page). `{rd}` is replaced by the encoded return address,
# built from PUBLIC_ORIGIN + APP_BASE_PATH. Empty = the UI says there is nowhere to send back.
# AUTH_LOGIN_URL=https://example.org/oauth2/start?rd={rd}

# The origin the application is served under for the browser, and the path beneath it.
# PUBLIC_ORIGIN=http://localhost:8080
# APP_BASE_PATH=/claude-usage

# --- Ingest: one token per MACHINE ---
# Format: token:machine_name[,token2:name2]
# The token identifies the MACHINE. The account is recognized dynamically from
# oauthAccount.accountUuid, because on one machine you switch between accounts via /login —
# a static label would assign half the samples to the wrong account.
# Generate with: openssl rand -hex 32
INGEST_TOKENS=replace_me_with_random_hex:desktop

# --- SSE stream (/api/stream) ---
# Token for clients WITHOUT an SSO cookie: the AX206 panel, scripts. Format: token:label[,...]
# This is a SEPARATE secret from INGEST_TOKENS and must stay one. The probe token is a
# credential for WRITING only and lies handed out on every machine; if it also opened reading
# the state of all accounts, its meaning would widen quietly — no rotation, no decision.
# Empty value = the stream is reachable only through SSO from a browser.
# Generate with: openssl rand -hex 32
STREAM_TOKENS=
# The ping keeps the connection alive through Apache, but what matters more is that it makes
# a disconnected client detectable — without it a dead subscription hangs in the broker.
STREAM_PING_SEC=15
# Hard cap on connection lifetime. This is the ONLY moment an SSO session is re-verified
# in a long stream. EventSource resumes on its own, so it is invisible to the browser.
STREAM_MAX_LIFETIME_SEC=900
STREAM_MAX_CLIENTS=32
# How many frames may pile up for a slow receiver before it gets `lag` instead of history.
STREAM_QUEUE_MAX=32

# --- Edge filter in Apache ---
# A shared secret checked BEFORE anything reaches the backend. It is not serious cryptography —
# it cuts off scanners so they never touch Python, the database or the logs. The real authorization is INGEST_TOKENS.
# Injected into the vhost at deployment, NOT committed. Generate with: openssl rand -hex 32
INGEST_EDGE_KEY=replace_me_with_random_hex

# --- Ingest behavior ---
LOG_LEVEL=INFO
MAX_INGEST_BODY_BYTES=262144
MAX_BACKLOG_ENTRIES=200
# Threshold for the clock_skew EVENT — diagnostics, not rejection of data. The server dates
# the measurement: the client gives the age (sent_at - captured_at), the server computes received_at - age.
CLOCK_SKEW_TOLERANCE_SEC=300

# Dedup: a new row only when the value changed OR this many seconds have passed.
# The probe polls every ~120 s and utilization changes rarely — without this the table would
# swell with identical rows.
SAMPLE_HEARTBEAT_SEC=300

# Monotonicity guard: with resets_at UNCHANGED, a drop larger than this many percentage
# points is treated as a stale read from another machine (each has its own cache); it is
# stored with the stale_read flag and does NOT roll the current state back.
MONOTONIC_EPS=0.5

# --- Freshness in /api/status ---
# A sample younger than this => "live". The probe is throttled to 120 s, so 300 s leaves room.
FRESH_WINDOW_SEC=300
# No signal at all from a client for longer than this => state "unknown", not "0%".
CLIENT_SILENT_SEC=21600

# --- Port publication ---
# By default 127.0.0.1:8080, that is, only from the local machine. `0.0.0.0:8080` exposes the
# backend to the whole network — do that only together with an AUTH_MODE other than `none`.
# BACKEND_BIND=127.0.0.1:8080
#
# Behind a reverse proxy do not publish the port at all: the proxy reaches the container over
# the Docker network. An empty value HERE IS NOT ENOUGH (`:-` fires on an empty one too).
# Only docker-compose.override.yml takes it away:
#
#   services:
#     claude_usage_monitor_backend:
#       ports: !reset []
